<Window x:Class="FocusCapture.Windows.SkillAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill 依赖授权"
        Width="470" Height="668"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- PasswordBox 必须单独给样式：不写的话它走系统默认（白底黑字），
             在深色窗口里既刺眼又和旁边的输入框不是一套（本项目一律深色，不留浅色控件）。 -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadText"
                   Text="用飞书扫码授权"
                   FontSize="15" Foreground="#F0F0F0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="DepText" Margin="0,8,0,0"
                   Foreground="#AAAAAA" TextWrapping="Wrap"
                   Text="依赖：飞书（lark-cli）"/>

        <!-- ── 第一次使用：先让用户选「创建应用」还是「我有现成凭据」 ──
             两条路都要用户动手（前者要去浏览器、后者要粘凭据），所以这里不自动开始；
             凭据已就绪的机器走不到这个面板，仍然是零点击自动出码。 -->
        <StackPanel Grid.Row="2" x:Name="FirstRunPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <Border Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="FirstRunText" TextWrapping="Wrap"
                               Foreground="#C8C8C8" FontSize="12" LineHeight="19"
                               Text="第一次使用需要先有一个飞书应用。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CreateAppButton" Content="创建飞书应用（推荐）"
                                Click="OnCreateApp" Padding="12,7"/>
                        <Button x:Name="UseCredentialButton" Content="我有现成凭据"
                                Margin="8,0,0,0" Click="OnShowCredential" Padding="12,7"
                                Background="#2E2E2E" BorderBrush="#3E3E3E" Foreground="#B0B0B0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 依赖不在位：连授权都开始不了，先把它装下来（设计稿 §4.4 触发点 2）──
             实测这一格很少被走到（组件不在位时设置页的授权按钮本来就是禁用的），
             但只要有人从别处打开这个窗口，它就该给出**应用内**的下一步，而不是让用户自己去想办法。 -->
        <StackPanel Grid.Row="2" x:Name="MissingPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <Border Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="MissingText" TextWrapping="Wrap"
                               Foreground="#C8C8C8" FontSize="12" LineHeight="19"
                               Text="这个组件还没装到本机。点下面的按钮由本应用下载安装，不用你去装任何东西。"/>
                    <Button x:Name="DownloadDepButton" Content="下载并继续" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="OnDownloadDependency" Padding="12,7"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 兜底入口：粘贴现成凭据（输入框按协议给的字段动态渲染） ── -->
        <StackPanel Grid.Row="3" x:Name="CredentialPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <Border Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#C8C8C8" FontSize="12" LineHeight="19"
                               Text="把飞书开放平台上的应用凭据粘到下面。凭据只交给飞书命令行保存，本应用不留副本、不写日志。"/>
                    <StackPanel x:Name="CredentialInputs" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SubmitCredentialButton" Content="用它继续"
                                Click="OnSubmitCredential" Padding="12,7"/>
                        <Button x:Name="BackToCreateButton" Content="返回上一步"
                                Margin="8,0,0,0" Click="OnBackToCreate" Padding="12,7"
                                Background="#2E2E2E" BorderBrush="#3E3E3E" Foreground="#B0B0B0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="4" x:Name="QrBorder" Margin="0,14,0,0" Width="320" Height="320"
                HorizontalAlignment="Center"
                Background="#FFFFFF" CornerRadius="6" Padding="10">
            <Grid>
                <TextBlock x:Name="QrPlaceholder" Text="正在生成二维码…"
                           Foreground="#666666" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Image x:Name="QrImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" x:Name="ScanHintText" Margin="0,12,0,4"
                   Foreground="#888888" FontSize="11"
                   Text="用飞书 App 扫上面的码 → 在手机上点「确认授权」。扫码后本窗口会自动完成，不用再点任何按钮。"/>

        <TextBox Grid.Row="6" x:Name="UrlBox" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="46" VerticalScrollBarVisibility="Auto"
                 ToolTip="二维码扫不了时，可以复制这个链接在浏览器里打开"/>

        <TextBlock Grid.Row="7" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#CFCFCF" TextWrapping="Wrap"
                   Text="正在获取授权码…"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLinkButton" Content="在浏览器打开" Margin="0,0,8,0" Click="OnOpenLink"/>
            <Button x:Name="RetryButton" Content="重新生成二维码" Margin="0,0,8,0" Click="OnRetry" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="取消" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
