<Window x:Class="FocusCapture.Windows.DropActionCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <!--
      文件拖到悬浮球后浮出的紧凑卡片。
      宽度 276px 上限、**贴合内容** —— 旧版卡片右侧留一大片空白，被用户否掉了。
      选项**不带图标**，靠**整行**悬停高亮表达"鼠标停在哪一行"（整行铺满后右侧那片空白也变成可点区域）。
      末项「以后新增的渠道」已改成「更多渠道，敬请期待」（灰色不可点）。
      以上视觉决策都属**被用户否掉的旧版**，改之前先看清旧版是什么，别按旧版实现。
    -->
    <Window.Resources>
        <!-- 卡片选项行：无图标、左对齐、整行悬停高亮、行高 28、圆角 4、行间距 1 -->
        <Style x:Key="CardRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- 未实现项：灰、不可点、**无悬停** -->
                                <Setter Property="Foreground" Value="#666666"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border MaxWidth="276"
            Background="#2D2D2D"
            BorderBrush="#444444"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       FontFamily="Microsoft YaHei UI"
                       Foreground="#E0E0E0"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText"
                       FontSize="12"
                       FontFamily="Microsoft YaHei UI"
                       Foreground="#888888"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <Border Height="1" Background="#3A3A3A" Margin="0,8,0,4"/>

            <Button x:Name="BtnAiAsk" Content="用 AI 问答打开" Style="{StaticResource CardRow}"
                    Click="BtnAiAsk_Click"/>
            <Button x:Name="BtnSaveToCloud" Content="存到网盘" Style="{StaticResource CardRow}"
                    Click="BtnSaveToCloud_Click"/>
            <Button x:Name="BtnGetNote" Content="发到得到大脑" Style="{StaticResource CardRow}"
                    Click="BtnGetNote_Click"/>
            <!-- 占位：后续新增渠道往上面加一行，这一行始终留在最后。卡片**不硬编码渠道名**，走 OutboundDestination 目录 -->
            <Button x:Name="BtnMore" Content="更多渠道，敬请期待" Style="{StaticResource CardRow}"
                    IsEnabled="False"/>
        </StackPanel>
    </Border>
</Window>
