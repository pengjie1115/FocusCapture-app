<UserControl x:Class="FocusCapture.Windows.Controls.ChatSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FocusCapture.Windows.Controls"
             FontFamily="Microsoft YaHei UI" FontSize="13"
             Background="{DynamicResource Chat_1E1E1E}"
             Loaded="ChatSidebar_Loaded" Unloaded="ChatSidebar_Unloaded">
    <!-- AI 问答侧边栏（2026-09-23 重构，取代历史抽屉）。
         分区自上而下：新对话 / 新分组 →（收藏 · 各分组）→ 置顶 → 最近 → 用户区。
         数据由宿主经 Load() 注入；所有业务动作（改字段 / 删除 / 导出）抛事件给宿主执行 ——
         本控件不直接改会话文件，与旧抽屉保持同一条纪律。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 顶部两个入口 ── -->
        <StackPanel Grid.Row="0" Margin="10,10,10,4">
            <Button x:Name="BtnNewChat" Click="BtnNewChat_Click"
                    HorizontalContentAlignment="Left" Padding="10,7"
                    Background="{DynamicResource Chat_2A2A2A}" Foreground="{DynamicResource Chat_E0E0E0}"
                    BorderBrush="{DynamicResource Chat_3A3A3A}" BorderThickness="1"
                    Cursor="Hand" ToolTip="开一个不属于任何分组的新对话">
                <TextBlock Text="＋  新对话"/>
            </Button>
            <Button x:Name="BtnNewGroup" Click="BtnNewGroup_Click"
                    HorizontalContentAlignment="Left" Padding="10,7" Margin="0,6,0,0"
                    Background="{DynamicResource Chat_2A2A2A}" Foreground="{DynamicResource Chat_C8C8C8}"
                    BorderBrush="{DynamicResource Chat_3A3A3A}" BorderThickness="1"
                    Cursor="Hand" ToolTip="建一个带指令的分组（进分组后说的指令默认都对着它）">
                <TextBlock Text="＋  新分组"/>
            </Button>
        </StackPanel>

        <!-- ── 列表区（收藏 / 各分组 / 置顶 / 最近）── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0,6,6">
            <ItemsControl x:Name="ListHost">
                <ItemsControl.Resources>
                    <!-- 纯分区标题（置顶 / 最近）-->
                    <DataTemplate DataType="{x:Type local:SidebarSectionHeader}">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource Chat_7A7A7A}" FontSize="11"
                                   Margin="8,12,8,4"/>
                    </DataTemplate>

                    <!-- 可点击的分组行（收藏也走这一支，靠 GroupId 区分）-->
                    <DataTemplate DataType="{x:Type local:SidebarGroupHeader}">
                        <Border x:Name="GroupRow" Background="Transparent" CornerRadius="4"
                                Padding="8,6" Margin="0,1" Cursor="Hand"
                                MouseLeftButtonUp="GroupRow_Click" Tag="{Binding}"
                                ToolTip="{Binding Tooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Chat_D0D0D0}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- 置顶标记（2026-09-24）：置顶的分组排到列表最前，这里给个可见记号 ——
                                     否则用户点完「置顶此分组」只看到它换了位置，不确定是真生效还是眼花 -->
                                <Border x:Name="PinBadge" Grid.Column="1" Margin="6,0,0,0"
                                        Padding="4,0" CornerRadius="3" Background="{DynamicResource Chat_2E3A2E}"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="置顶" FontSize="10" Foreground="{DynamicResource Chat_7A9E7A}"/>
                                </Border>
                                <!-- 三点：仅鼠标悬停时出现（2026-09-23，参照千问）-->
                                <Button x:Name="GroupMore" Grid.Column="2" Content="⋮"
                                        Width="20" Height="20" Padding="0"
                                        Background="Transparent" Foreground="{DynamicResource Chat_9A9A9A}"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Tag="{Binding}" Click="GroupMore_Click"
                                        ToolTip="重命名 / 置顶 / 删除"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- ⚠️ 悬停高亮必须用 Trigger SourceName，**禁止**改回
                                 DataTrigger + RelativeSource AncestorType=Border：
                                 DataTemplate 里那种写法会越过条目自身的 Border、绑到外层共享的
                                 滚动区外壳 Border 上 —— 结果是鼠标进列表任意位置，所有条目一起高亮
                                 （2026-09-24 用户实测：悬停任一条目全员高亮 + 切换时闪屏）。 -->
                            <Trigger SourceName="GroupRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="GroupRow" Property="Background" Value="{DynamicResource Chat_2E2E2E}"/>
                                <Setter TargetName="GroupMore" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 收藏是系统保留分区：不能重命名 / 置顶 / 删除，干脆不给三点入口。
                                 放在悬停 Trigger 之后 —— 同一目标的同一属性，后定义者生效。 -->
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="GroupMore" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- 会话条目（2026-09-26 补复选框：批量模式下与分组视图同款 ——
                         行首出勾选框、行尾三点让位；平时三点仍悬停才出现） -->
                    <DataTemplate DataType="{x:Type local:HistoryItemViewModel}">
                        <Border x:Name="SessionRow" Background="Transparent" CornerRadius="4"
                                Padding="8,5" Margin="0,1" Cursor="Hand"
                                MouseLeftButtonUp="SessionRow_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="BatchCheck" Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Visibility="{Binding BatchCheckVis}"
                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                          Tag="{Binding}" Click="BatchCheck_Click"/>
                                <TextBlock x:Name="SessionTitle" Grid.Column="1"
                                           Text="{Binding Title}" Foreground="{DynamicResource Chat_C8C8C8}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Preview}"/>
                                <!-- 最后聊天时间（2026-09-26 用户要求改**相对时间**：
                                     刚刚 / N分钟前 / N小时前 / N天前，由 ChatSidebar 的分钟定时器重算）。
                                     分组视图与搜索窗仍绑 TimeText（日期 + 详细时间），保持原样。 -->
                                <TextBlock Grid.Column="2" Text="{Binding RelativeTimeText}"
                                           Foreground="{DynamicResource Chat_6E6E6E}" FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <!-- 会话的三点：重命名 / 置顶 / 收藏 / 分组到… / 导出 / 删除。
                                     换控件不能丢功能 —— 这些入口原先散在旧抽屉的菜单里。 -->
                                <Button x:Name="SessionMore" Grid.Column="3" Content="⋮"
                                        Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                        Background="Transparent" Foreground="{DynamicResource Chat_9A9A9A}"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Tag="{Binding}" Click="SessionMore_Click"
                                        ToolTip="重命名 / 置顶 / 收藏 / 分组到… / 导出 / 删除"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- 同分组行：必须 Trigger SourceName，禁止 RelativeSource AncestorType=Border（原因见分组行注释） -->
                            <Trigger SourceName="SessionRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="SessionRow" Property="Background" Value="{DynamicResource Chat_2E2E2E}"/>
                                <Setter TargetName="SessionMore" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 批量选中的高亮（带品牌绿的底色，与普通悬停区分）；放悬停之后 = 选中态优先 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SessionRow" Property="Background" Value="{DynamicResource Chat_33422E}"/>
                            </DataTrigger>
                            <!-- 批量模式：三点让位给复选框（后定义者覆盖悬停 Trigger 的显隐） -->
                            <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                <Setter TargetName="SessionMore" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── 批量操作条（2026-09-24 找回；2026-09-26 用户改版）──
             改版前是「计数提示语 + 删除/移入分组/取消」；现在与分组视图的批量条同款：
             左 = 全选勾选框 + 已选计数（不设上限 →「已选 n」）；右 = 取消 / 移入分组 / 删除（红底）。
             原「点会话选中，再选下面的操作」提示语按用户要求删除。 -->
        <Border x:Name="BatchBar" Grid.Row="2" BorderBrush="{DynamicResource Chat_2E2E2E}" BorderThickness="0,1,0,0"
                Padding="10,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="BatchSelectAll" Grid.Column="0" Content="全选"
                          Foreground="{DynamicResource Chat_C8C8C8}" FontSize="12" VerticalAlignment="Center"
                          Cursor="Hand" Click="BatchSelectAll_Click"/>
                <TextBlock x:Name="BatchCount" Grid.Column="1" Text="已选 0"
                           Foreground="{DynamicResource Chat_9A9A9A}" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnBatchCancel" Grid.Column="2" Content="取消" Click="BtnBatchCancel_Click"
                        Padding="8,3" Margin="6,0,0,0" FontSize="12" Cursor="Hand"
                        Background="{DynamicResource Chat_2A2A2A}" Foreground="{DynamicResource Chat_C8C8C8}" BorderBrush="{DynamicResource Chat_3A3A3A}" BorderThickness="1"/>
                <Button x:Name="BtnBatchGroup" Grid.Column="3" Content="移入分组" Click="BtnBatchGroup_Click"
                        Padding="8,3" Margin="6,0,0,0" FontSize="12" Cursor="Hand"
                        Background="{DynamicResource Chat_2A2A2A}" Foreground="{DynamicResource Chat_C8C8C8}" BorderBrush="{DynamicResource Chat_3A3A3A}" BorderThickness="1"/>
                <Button x:Name="BtnBatchDelete" Grid.Column="4" Content="删除" Click="BtnBatchDelete_Click"
                        Padding="10,3" Margin="6,0,0,0" FontSize="12" Cursor="Hand"
                        Background="#C0392B" Foreground="#FFFFFF" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ── 底部用户区（头像 + 昵称）── -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Chat_2E2E2E}" BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="26" Height="26">
                    <!-- 默认：昵称首字色块；设了头像则显示图片盖住它。
                         2026-09-26：头像按用户要求裁成**圆形** —— 方图此前直接摆着就是方角。
                         Clip 用绝对坐标（圆心 13,13 / 半径 13 = 26×26 的一半）；
                         改这个 Grid 尺寸时半径与圆心必须同步改。 -->
                    <Ellipse Fill="{DynamicResource Chat_3A4A6A}"/>
                    <TextBlock x:Name="AvatarInitial" Text="" Foreground="{DynamicResource Chat_D8E0F0}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                        </Image.Clip>
                    </Image>
                </Grid>
                <TextBlock x:Name="UserNickname" Grid.Column="1" Margin="8,0,0,0"
                           Foreground="{DynamicResource Chat_B8B8B8}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- 回收站入口（2026-09-23）：旧抽屉头部那个「回收站」按钮随抽屉一起退场了，
                     功能不能丢 —— 挪到用户区右侧。放这里而不是顶部：它不是高频动作。 -->
                <Button x:Name="BtnRecycleBin" Grid.Column="2" Content="回收站"
                        Padding="6,2" FontSize="11"
                        Background="Transparent" Foreground="{DynamicResource Chat_7A9E7A}"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnRecycleBin_Click"
                        ToolTip="已删除的会话（还能从这里恢复）"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
