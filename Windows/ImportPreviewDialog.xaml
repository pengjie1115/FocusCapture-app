<Window x:Class="FocusCapture.Windows.ImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCapture.Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="540" Height="420"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="导入预览"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 关闭按钮：显式清零 Padding（理由同 ExportDialog：全局样式 8,4 会挤压 24px 小按钮） -->
                    <Button Content="×" FontSize="16"
                            Width="24" Height="24"
                            Padding="0"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 中部：源信息 + 目标日期 + 预览列表 -->
            <Grid Grid.Row="1" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 源信息 -->
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="SourcePathText"
                               Foreground="#888888" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="SummaryText"
                               Foreground="#4CAF50" FontSize="12"
                               Margin="0,4,0,8"/>
                </StackPanel>

                <!-- 目标日期选择：弃用 DatePicker（DatePickerTextBox internal 类 + ThemeStyle 锁，无法调深色），
                     改用 TextBox(深色，全局 Style 兜底) + 📅Button 弹 CalendarWindow 复用 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标日期"
                               Foreground="#999999" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TargetDateInput" Grid.Column="1"
                             Height="28" FontSize="12"
                             VerticalContentAlignment="Center"
                             LostFocus="TargetDateInput_LostFocus"
                             KeyDown="TargetDateInput_KeyDown"/>
                    <Button Grid.Column="2" x:Name="BtnPickTargetDate" Content="📅"
                            FontSize="12" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                            Cursor="Hand" ToolTip="选目标日期"
                            Click="BtnPickTargetDate_Click"/>
                </Grid>

                <!-- 工具栏：全选/反选/计数 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBlock x:Name="SelectedCountText"
                               Foreground="#4CAF50" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnSelectAll" Content="全选"
                            FontSize="11" Width="48" Height="22"
                            Background="Transparent" Foreground="#888888"
                            BorderBrush="#555555" BorderThickness="1" Cursor="Hand"
                            Margin="0,0,4,0" Click="BtnSelectAll_Click"/>
                    <Button x:Name="BtnInvert" Content="反选"
                            FontSize="11" Width="48" Height="22"
                            Background="Transparent" Foreground="#888888"
                            BorderBrush="#555555" BorderThickness="1" Cursor="Hand"
                            Margin="0,0,4,0" Click="BtnInvert_Click"/>
                </StackPanel>

                <!-- 预览列表 -->
                <ListBox x:Name="PreviewList" Grid.Row="3"
                         Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A2A" CornerRadius="4" Padding="8,6" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,8,0"
                                              Cursor="Hand"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="#888888" FontSize="10"
                                                   Text="{Binding TimestampText}"
                                                   Visibility="{Binding TimestampText, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Foreground="#E0E0E0" FontSize="12"
                                                   Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Foreground="#555555" FontSize="10"
                                                   Text="{Binding SourceWindow}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding SourceWindow, Converter={StaticResource StrVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="14,0,14,14">
                <Button Content="取消" Width="70" Height="30"
                        Background="#3A3A3A" Foreground="#AAAAAA"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="导入" Width="80" Height="30"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>