<Window x:Class="FocusCapture.Windows.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="170"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="全局查找"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 关闭按钮（2026-09-13 修正）：原为文本字符「×」且未清 Padding，
                         全局 Button 样式带的 Padding="8,4" 把 24px 宽的内容区压到只剩 8px，
                         字符被挤压偏移；同时 #888888 在深色底上偏暗。 -->
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Width="24" Height="24"
                            Padding="0"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 输入框 + 提示 -->
            <StackPanel Grid.Row="1" Margin="16,14,16,8">
                <TextBlock x:Name="HintText"
                           Text="搜索内容 / 编辑内容 / 来源窗口（不区分大小写）。留空确认可清除当前查找"
                           Foreground="#888888" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <!-- 2026-08-15 修复：高度 30→36 让 13px 字体完整显示，VerticalContentAlignment Center 让内容垂直居中；
                     Background/Foreground 等由 App.xaml 全局 TextBox Style 提供，避免 Aero 主题白底覆盖 -->
                <TextBox x:Name="InputBox"
                         FontSize="13" Height="36"
                         VerticalContentAlignment="Center"
                         TextChanged="InputBox_TextChanged"/>
            </StackPanel>

            <!-- 按钮区：App.xaml 全局 Button Style 已处理 IsEnabled=False 灰显 + IsMouseOver 高亮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="16,0,16,14">
                <Button Content="取消" Width="70" Height="30"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="查找" Width="70" Height="30"
                        Click="BtnOk_Click">
                    <Button.Style>
                        <!-- 在全局 Button Style 基础上，仅本地覆盖默认蓝色 + IsEnabled 时变深灰蓝 -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#0078D4"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A86D9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#005FA3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#2A4A6A"/>
                                    <Setter Property="Foreground" Value="#88B0CC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>