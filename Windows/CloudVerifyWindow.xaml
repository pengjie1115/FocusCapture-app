<Window x:Class="FocusCapture.Windows.CloudVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="640" Height="560"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="与云端核对结果"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 关闭按钮：显式清零 Padding（全局样式 8,4 会挤压 24px 小按钮） -->
                    <Button Content="×" FontSize="16"
                            Width="24" Height="24" Padding="0"
                            Background="Transparent" Foreground="#888888"
                            BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 概况 -->
            <StackPanel Grid.Row="1" Margin="14,12,14,0">
                <TextBlock x:Name="SummaryText" Foreground="#4CAF50" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="核对只读取网盘清单，不下载、不上传、不改动任何文件。下面列出的差异在你点「应用标注」之前不会写进记录。"/>
            </StackPanel>

            <!-- 「云端已不存在」标题 + 工具 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,14,14,4">
                <TextBlock x:Name="MissingHeaderText"
                           Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnSelectAll" Content="全选"
                        FontSize="11" Width="48" Height="22"
                        Background="Transparent" Foreground="#888888"
                        BorderBrush="#555555" BorderThickness="1" Cursor="Hand"
                        Margin="0,0,4,0" Click="BtnSelectAll_Click"/>
                <Button x:Name="BtnInvert" Content="反选"
                        FontSize="11" Width="48" Height="22"
                        Background="Transparent" Foreground="#888888"
                        BorderBrush="#555555" BorderThickness="1" Cursor="Hand"
                        Click="BtnInvert_Click"/>
            </StackPanel>

            <ListBox x:Name="MissingList" Grid.Row="3" Margin="14,0"
                     Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" CornerRadius="4" Padding="8,6" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Top" Margin="0,2,8,0"
                                          Cursor="Hand" Click="ItemCheck_Click"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="#E0E0E0" FontSize="12"
                                               Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="#888888" FontSize="10"
                                               Text="{Binding Detail}" TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 云端多出 -->
            <StackPanel Grid.Row="4" Margin="14,12,14,4">
                <TextBlock x:Name="CloudOnlyHeaderText"
                           Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="这些文件在网盘里有、本地却没有记录（可能是另一台设备刚上传、清单还在同步路上，也可能是你手动放进网盘的）。核对不会把它们登记进来，也不会改动它们。"/>
            </StackPanel>

            <ListBox x:Name="CloudOnlyList" Grid.Row="5" Margin="14,0" MaxHeight="110"
                     Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#999999" FontSize="11"
                                   TextWrapping="Wrap" Margin="8,4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部按钮：两个出口语义不同，刻意分开放 -->
            <DockPanel Grid.Row="6" Margin="14,14,14,14" LastChildFill="False">
                <Button x:Name="BtnRemoveSelected" Content="移除选中记录" DockPanel.Dock="Left"
                        Width="124" Height="30"
                        Background="Transparent" Foreground="#E08A8A"
                        BorderBrush="#7A4444" BorderThickness="1" Cursor="Hand"
                        ToolTip="只从记录里去掉这条，本机文件不会被删除"
                        Click="BtnRemoveSelected_Click"/>
                <Button x:Name="BtnApply" Content="应用标注" DockPanel.Dock="Right"
                        Width="90" Height="30"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        ToolTip="把「云端已不存在」写进本地记录（只改状态，不动任何文件）"
                        Click="BtnApply_Click"/>
                <Button x:Name="BtnClose" Content="关闭" DockPanel.Dock="Right"
                        Width="70" Height="30" Margin="10,0,0,0"
                        Background="#3A3A3A" Foreground="#AAAAAA"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnClose_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
