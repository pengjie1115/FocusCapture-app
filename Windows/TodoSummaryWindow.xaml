<Window x:Class="FocusCapture.Windows.TodoSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办汇总"
        Width="360" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行 + 一键清理（v3.7）：把当前显示的全部未办（已提醒暂缓/待处理/已过期）一键标为已完成 -->
        <Grid Grid.Row="0" Margin="2,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="待办汇总"
                       Foreground="#E0E0E0" FontSize="15" FontWeight="Bold"/>
            <Button x:Name="BtnCleanAll"
                    Grid.Column="1"
                    Content="一键清理"
                    Click="BtnCleanAll_Click"
                    Padding="8,3" FontSize="12"/>
        </Grid>

        <!-- 编辑保存后的时间识别建议条（2026-09-22）。**位置钉在面板顶部固定行**，不能挂在被编辑那一行上：
             汇总面板只显示「今天及以前」的待办，在编辑框里写个未来时间（如 2026-09-25 09:00）保存后，
             这条待办会立刻移出本面板（归到灵感速览的「未到期」档），行都没了，挂在行上的建议条无处安放。
             文案里会明说「已移入「未到期」档」，避免用户以为东西丢了。 -->
        <Border x:Name="SuggestBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#2D2D2D"
                BorderBrush="#4CAF50" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <!-- 文案占整宽、按钮另起一行右对齐：360px 宽的面板里并排摆放会把文案挤成三行、
                     "设为提醒？"只剩问号挂在一行（2026-09-22 出图实测） -->
                <TextBlock x:Name="SuggestText"
                           Foreground="#CCCCCC" FontSize="12"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="BtnSuggestSet" Content="设为提醒"
                            Click="BtnSuggestSet_Click"
                            Foreground="#4CAF50" BorderBrush="#4CAF50"
                            Padding="8,3" FontSize="12"/>
                    <Button x:Name="BtnSuggestIgnore" Content="忽略"
                            Click="BtnSuggestIgnore_Click"
                            Margin="6,0,0,0" Padding="8,3" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 空态 -->
        <TextBlock x:Name="EmptyText"
                   Grid.Row="2"
                   Text="没有待办事项"
                   Foreground="#888888" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- v2（2026-08-28）三分组：已提醒暂缓(Read) 最上 → 待处理 中间 → 已过期 最后；只显示今天及以前 -->
                <TextBlock x:Name="ReadHeaderText"
                           Text="已提醒暂缓"
                           Foreground="#E8A33D" FontSize="13" FontWeight="Bold"
                           Margin="2,0,0,6"/>
                <StackPanel x:Name="ReadList"/>

                <TextBlock x:Name="PendingHeaderText"
                           Text="待处理"
                           Foreground="#4CAF50" FontSize="13" FontWeight="Bold"
                           Margin="2,10,0,6"/>
                <StackPanel x:Name="PendingList"/>

                <TextBlock x:Name="OverdueHeaderText"
                           Text="已过期"
                           Foreground="#E05A5A" FontSize="13" FontWeight="Bold"
                           Margin="2,10,0,6"/>
                <StackPanel x:Name="OverdueList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>