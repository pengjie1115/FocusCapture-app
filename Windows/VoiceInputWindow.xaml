<Window x:Class="FocusCapture.Windows.VoiceInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="False"
        Width="900" Height="600"
        MinWidth="500" MinHeight="350"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <DropShadowEffect x:Key="MenuShadow" BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="10"
            Background="#2D2D2D"
            BorderBrush="#3A3A3A" BorderThickness="1"
            Effect="{StaticResource MenuShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="8*" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*" MinHeight="60" MaxHeight="200"/>
            </Grid.RowDefinitions>

            <!-- ====== 标题栏 ====== -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="#333333"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="8,0">
                    <Button x:Name="BtnBurger"
                            Content="☰" FontSize="16"
                            Width="32" Height="28"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="BtnBurger_Click">
                        <Button.ContextMenu>
                            <ContextMenu Background="#333333" Foreground="#D0D0D0" BorderBrush="#3A3A3A" FontSize="13" StaysOpen="False">
                                <MenuItem Header="  新建"           Click="MenuNew_Click"      Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                <MenuItem Header="  保存  Ctrl+S"    Click="MenuSave_Click"     Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                <Separator/>
                                <MenuItem Header="  导出 / Markdown" Click="MenuExportMd_Click"  Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                <MenuItem Header="  导出 / Word"     Click="MenuExportDocx_Click" Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                <MenuItem Header="  导出 / 纯文本"   Click="MenuExportTxt_Click" Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock Text="沉浸记录"
                               Foreground="#CCCCCC"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnSettings"
                                Content="▽" FontSize="12"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                Click="BtnSettings_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SettingsMenu" Background="#333333" Foreground="#D0D0D0" BorderBrush="#3A3A3A" FontSize="13" StaysOpen="False">
                                    <MenuItem Header="  深色模式" Click="MenuThemeDark_Click"  Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                    <MenuItem Header="  浅色模式" Click="MenuThemeLight_Click" Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                    <Separator/>
                                    <MenuItem x:Name="MenuPinTop" Header="  置顶" Click="MenuPinTop_Click" Background="#333333" Foreground="#D0D0D0" Padding="16,8"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="BtnMinimize"
                                Content="─" FontSize="14"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize"
                                Content="□" FontSize="12"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,2,0"
                                Click="BtnMaximize_Click"/>
                        <Button x:Name="BtnClose"
                                Content="✕" FontSize="13"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====== 正文编辑区 ====== -->
            <TextBox x:Name="ContentBox"
                     Grid.Row="1"
                     Background="#262626"
                     Foreground="#D0D0D0"
                     CaretBrush="#4CAF50"
                     BorderThickness="0"
                     FontSize="15"
                     FontFamily="Microsoft YaHei UI"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="16,12"
                     SpellCheck.IsEnabled="False"
                     TextChanged="ContentBox_TextChanged"/>

            <!-- ====== 分隔条 ====== -->
            <GridSplitter x:Name="VoiceSplitter"
                          Grid.Row="2"
                          Height="5"
                          Background="#3A3A3A"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          DragCompleted="Splitter_DragCompleted"/>

            <!-- ====== 底部语音区 ====== -->
            <Border x:Name="BottomInputArea"
                    Grid.Row="3"
                    Background="#333333"
                    CornerRadius="0,0,10,10"
                    Padding="10,8">
                <Button x:Name="BtnVoice"
                        Background="#3A3A3A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnVoice_Click">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="VoiceIcon"
                                       Text="🎙" FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="VoiceStatusText"
                                       Text="开始说话"
                                       Foreground="#CCCCCC"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar x:Name="VolumeBar"
                                     Minimum="0" Maximum="1"
                                     Value="0"
                                     Height="2"
                                     Background="#2D2D2D"
                                     Foreground="#4CAF50"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Bottom"
                                     Visibility="Collapsed"/>
                    </Grid>
                </Button>
            </Border>

            <!-- 字数警告条 -->
            <Border x:Name="WarningBar"
                    Grid.Row="3"
                    Background="#E53935"
                    CornerRadius="4"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,54"
                    Visibility="Collapsed">
                <TextBlock Text="内容过长可能影响性能，建议分段保存"
                           Foreground="White" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
