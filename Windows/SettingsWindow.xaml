                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="BtnBaiduAuthorize" Content="开始授权"
                                Width="100" Height="30" HorizontalAlignment="Left"
                                Click="BtnBaiduAuthorize_Click"/>
                        <Button x:Name="BtnBaiduTest" Content="测试连接"
                                Width="90" Height="30" Margin="8,0,0,0"
                                Click="BtnBaiduTest_Click"/>
                        <Button x:Name="BtnBaiduRevoke" Content="取消授权"
                                Width="90" Height="30" Margin="8,0,0,0"
                                Click="BtnBaiduRevoke_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="BaiduStatusText" Text="尚未授权"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="本地容量上限（GB）" Width="150" VerticalAlignment="Center"/>
                        <TextBox x:Name="CacheMaxGbInput" Width="80" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 LostFocus="CacheMaxGb_LostFocus"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="闲置天数" Width="150" VerticalAlignment="Center"/>
                        <TextBox x:Name="CacheIdleDaysInput" Width="80" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 LostFocus="CacheIdleDays_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="超过上限或闲置超过该天数的本地副本会被释放（只删本机这份，网盘上的原文件不受影响，要用时再取回来）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="自动清理" Width="150" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CacheEvictCheck"
                                  Foreground="#E0E0E0" VerticalAlignment="Center"
                                  Checked="CacheEvict_Changed" Unchecked="CacheEvict_Changed">
                            <TextBlock Text="按上面两条规则自动释放本地副本" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>

                                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="BtnCacheClean" Content="立即清理"
                                Width="100" Height="30" HorizontalAlignment="Left"
                                Click="BtnCacheClean_Click"/>
                        <Button x:Name="BtnOpenFilesDir" Content="打开文件区"
                                Width="100" Height="30" Margin="8,0,0,0"
                                Click="BtnOpenFilesDir_Click"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="BtnRetryCloudCleanup" Content="重试云端清理"
                                Width="110" Height="30" HorizontalAlignment="Left"
                                ToolTip="把「云端待清理」的文件再删一轮（网络或授权修好后点这里）"
                                Click="BtnRetryCloudCleanup_Click"/>
                        <Button x:Name="BtnCopyCloudPath" Content="复制网盘路径"
                                Width="110" Height="30" Margin="8,0,0,0"
                                ToolTip="复制网盘附件目录路径，粘到百度网盘里手动清理（附件按月分子目录）"
                                Click="BtnCopyCloudPath_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="CacheStatusText"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <!-- 与云端核对（2026-09-27）：本地记录只增不减，过去从不与云端核对 ——
                         用户在网盘里手动删了文件，本机仍标着「云端已就绪」，AI 据此说错话。
                         这行是核对入口；报告窗口里的「移除记录」就是清理出口。 -->
                    <DockPanel Margin="0,16,0,0">
                        <Button x:Name="BtnCloudVerify" Content="与云端核对"
                                Width="110" Height="30" HorizontalAlignment="Left"
                                ToolTip="读取网盘里的实际清单，找出本地记录里「云端已经没有」的那些。只读：不下载、不上传、不改动任何文件"
                                Click="BtnCloudVerify_Click"/>
                        <TextBlock x:Name="CloudVerifyStatusText" Text="尚未核对过"
                                   Foreground="#999999" FontSize="11" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="核对只向网盘发 1 次请求、不消耗下载流量；发现的问题会先在报告里列出来，你确认后才写回记录"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="对话附件上传" Width="150" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AttachmentUploadCheck"
                                  Foreground="#E0E0E0" VerticalAlignment="Center"
                                  Checked="AttachmentUpload_Changed" Unchecked="AttachmentUpload_Changed">
                            <TextBlock Text="把对话里的图片/文档也自动传到网盘（默认关：附件只存本机）" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="附件云端保留" Width="150" VerticalAlignment="Center"/>
                        <TextBox x:Name="AttachmentRetentionInput" Width="80" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 LostFocus="AttachmentRetention_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="单位天，0 = 永久保留。只作用于对话附件；AI 产出的文件和你主动上传的文件在云端永久保留"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="当前数据目录" Width="150" VerticalAlignment="Center"/>
                        <TextBox x:Name="DataRootText" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="笔记、待办、对话、附件、文件区全都在这个目录下；默认在系统用户目录深处，可以改到更好找的位置"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="更改数据目录" Width="150" VerticalAlignment="Center"/>
                        <Button x:Name="BtnChangeRoot" Content="选择新位置并迁移"
                                Width="170" Height="30" HorizontalAlignment="Left"
                                Click="BtnChangeRoot_Click"/>
                        <Button x:Name="BtnOpenDataRoot" Content="打开当前目录"
                                Width="110" Height="30" Margin="8,0,0,0"
                                Click="BtnOpenDataRoot_Click"/>
                    </DockPanel>
                    <TextBlock Text="迁移只复制不移动：原目录内容一个字节都不会改也不会删，随时可以改回来。改完需要重启程序生效"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="DataRootStatusText"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ── 板块 9：通用 ── -->
                <StackPanel x:Name="PanelGeneral" Margin="24,18" Visibility="Collapsed">
                    <CheckBox x:Name="AutoStartCheck"
                              Content="开机自动启动"
                              Foreground="#E0E0E0"
                              Margin="0,4,0,0"
                              Checked="AutoStart_Changed"
                              Unchecked="AutoStart_Changed"/>

                    <!-- v3.8 灵感速览唤出行为已迁至「灵感速览」板块（v3.9） -->

                    <TextBlock Text="笔记存储路径" Margin="0,16,0,4"/>
                    <Grid>
                        <TextBox x:Name="NotesPathText"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="False"/>
                        <Button Content="浏览"
                                Width="60" HorizontalAlignment="Right"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="回收站" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRecycleBin" Content="打开回收站"
                                Width="120" HorizontalAlignment="Left"
                                Click="BtnRecycleBin_Click"/>
                    </DockPanel>
                    <TextBlock Text="找回被删除的笔记/待办（云同步时提供兜底）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <TextBlock Text="运行日志" Margin="0,16,0,4"/>
                    <DockPanel>
                        <Button Content="打开日志文件夹"
                                Width="120" HorizontalAlignment="Left"
                                Click="BtnOpenLogs_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Text="保留" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="LogRetentionInput"
                                     Style="{StaticResource DarkTextBox}"
                                     Width="50" TextChanged="LogRetention_TextChanged"/>
                            <TextBlock Text="天（1-365，默认 30）" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="程序运行记录（AI 工具调用/报错等），出问题时把对应时间点的日志文件发给开发者即可定位"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ── 板块 12：激活码（追加到末尾，勿插中间）── -->
                <StackPanel x:Name="PanelLicense" Margin="24,18" Visibility="Collapsed">
                    <TextBlock Text="当前状态" Margin="0,4,0,4"/>
                    <DockPanel>
                        <TextBlock x:Name="LicenseStatusText"
                                   Text="免费体验中"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="LicenseStatusDetail"
                               Text=""
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <TextBlock Text="激活码" Margin="0,16,0,4"/>
                    <TextBox x:Name="LicenseCodeInput"
                             Style="{StaticResource DarkTextBox}"
                             TextChanged="LicenseCodeInput_TextChanged"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="BtnActivateLicense"
                                Content="激活"
                                Width="90" HorizontalAlignment="Left"
                                Click="BtnActivateLicense_Click"/>
                        <TextBlock x:Name="LicenseMessageText"
                                   Text=""
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="粘贴激活码后点「激活」。激活码永久有效，一次激活长期可用。"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 关闭 -->
            <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="24,10">
                <Button Content="关闭"
                        Width="80"
                        IsDefault="True"
                        HorizontalAlignment="Right"
                        Click="BtnClose_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
