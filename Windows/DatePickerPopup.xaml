<UserControl x:Class="FocusCapture.Windows.DatePickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 预设菜单项：左对齐文字，悬停高亮，选中态由代码着色 -->
        <Style x:Key="PresetMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 月份翻页小按钮 -->
        <Style x:Key="MonthNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 弹层本体：StaysOpen=True，外击/宿主失活由代码关闭（与来源筛选 Popup 同一套模式） -->
    <Popup x:Name="PickerPopup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
        <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <StackPanel Orientation="Horizontal">
                <!-- 左列：6 个时间周期 + 自定义（常驻） -->
                <StackPanel x:Name="PresetMenu" Width="116" Margin="0,2,10,2"/>

                <!-- 右列：双月日历（仅自定义时展开） -->
                <StackPanel x:Name="CalendarPanel" Visibility="Collapsed">
                    <Grid Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="‹" Style="{StaticResource MonthNavButton}"
                                Click="BtnPrevMonth_Click"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthTitleLeft" Text="" Foreground="#E0E0E0"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthTitleRight" Text="" Foreground="#E0E0E0"
                                       FontSize="12" FontWeight="SemiBold" Margin="28,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="›" Style="{StaticResource MonthNavButton}"
                                Click="BtnNextMonth_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="MonthLeftHost" Margin="0,0,14,0"/>
                        <StackPanel x:Name="MonthRightHost"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
