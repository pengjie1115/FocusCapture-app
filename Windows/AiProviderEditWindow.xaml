<Window x:Class="FocusCapture.Windows.AiProviderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型供应商"
        Width="640" Height="600"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <!-- 禁用态必须自己上色：这套模板只有 hover 态，不给禁用态上色的话
                     「不能点」和「能点」长得一模一样（本项目在别的窗口上吃过这个亏）。
                     本窗口的「测试连接」「获取可用模型」在请求期间都会置灰。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#6E6E6E"/>
                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 供应商基本信息 ── -->
        <StackPanel Grid.Row="0">
            <DockPanel Margin="0,2">
                <TextBlock Text="模型供应商" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EditNameInput" Style="{StaticResource DarkTextBox}"
                         TextChanged="EditName_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,10">
                <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}"/>
                <Button x:Name="EditKeyApplyLink" DockPanel.Dock="Right" Content="申请 Key"
                        Margin="6,0,0,0" Visibility="Collapsed"
                        Click="EditKeyApplyLink_Click"/>
                <TextBox x:Name="EditBaseUrlInput" Style="{StaticResource DarkTextBox}"
                         TextChanged="EditBaseUrl_TextChanged"/>
            </DockPanel>
            <TextBlock x:Name="EditPresetHint" Style="{StaticResource HintText}"
                       Margin="110,2,0,0" Text=""/>

            <DockPanel Margin="0,10">
                <TextBlock Text="API 密钥" Style="{StaticResource FieldLabel}"/>
                <Button x:Name="EditKeyToggle" DockPanel.Dock="Right" Content="👁"
                        Width="34" Padding="2,2" Margin="6,0,0,0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip="显示 / 隐藏密钥" Click="EditKeyToggle_Click"/>
                <Grid>
                    <PasswordBox x:Name="EditKeyInput" Style="{StaticResource DarkPasswordBox}"
                                 PasswordChanged="EditKey_PasswordChanged"/>
                    <TextBox x:Name="EditKeyPlain" Style="{StaticResource DarkTextBox}"
                             Visibility="Collapsed" TextChanged="EditKeyPlain_TextChanged"/>
                </Grid>
            </DockPanel>
        </StackPanel>

        <!-- ── 模型目录 ── -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <Button x:Name="BtnAddModel" DockPanel.Dock="Right" Content="添加模型"
                        Width="96" Click="BtnAddModel_Click"/>
                <Button x:Name="BtnFetchModels" DockPanel.Dock="Right" Content="获取可用模型"
                        Width="120" Margin="0,0,6,0"
                        ToolTip="按当前 Base URL 与密钥向供应商拉取模型列表，勾选后添加"
                        Click="BtnFetchModels_Click"/>
                <TextBlock x:Name="EditModelCountText" DockPanel.Dock="Left" Text="模型目录"
                           Foreground="#E0E0E0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Margin="0,4,0,6"
                       Text="左侧填模型 ID（发给供应商的原始标识），右侧是给你自己看的显示名。点右侧箭头展开可单独设置该模型的上下文窗口与最大输出 Token。"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EditModelList" Margin="0,0,6,0"/>
            </ScrollViewer>

            <TextBlock Grid.Row="3" x:Name="EditEmptyHint" Style="{StaticResource HintText}"
                       Margin="0,8,0,0" Visibility="Collapsed"
                       Text="还没有模型。点右上「添加模型」手动填一个模型 ID；或保存后回列表页点「获取可用模型」自动列出。"/>

            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <Button x:Name="BtnEditTest" Content="测试连接"
                        Width="110" Height="30" HorizontalAlignment="Left" Click="BtnEditTest_Click"/>
                <TextBlock x:Name="EditTestResult" Text="" Foreground="#CCCCCC" FontSize="12"
                           TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <!-- ── 底部按钮 ── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="90" Height="32"
                    HorizontalAlignment="Right" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存" Width="90" Height="32" Margin="10,0,0,0"
                    HorizontalAlignment="Right" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
