<Window x:Class="FocusCapture.Windows.GetNoteDuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="480"
        SizeToContent="Height"
        MaxHeight="560"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 重复推送询问（2026-10-01）：检测到已推送过的条目时整批问一次，
         三按钮「仍要推送 / 跳过 / 取消」—— 替代旧版「直接静默跳过」，
         汇总版需要能把已推过的条目再包进去。样式对齐 ImportPreviewDialog 深色卡。 -->
    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="得到大脑 · 重复推送确认"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="×" FontSize="16" Width="24" Height="24" Padding="0"
                            Background="Transparent" Foreground="#888888" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand" Click="BtnCancel_Click"
                            ToolTip="取消本次推送"/>
                </Grid>
            </Border>

            <!-- 说明行 -->
            <TextBlock Grid.Row="1" x:Name="IntroText" Margin="16,12,16,4"
                       Foreground="#CCCCCC" FontSize="12.5" TextWrapping="Wrap"
                       LineHeight="20"/>

            <!-- 重复条目清单：只读列表，超出内部滚动 -->
            <Border Grid.Row="2" Margin="16,8,16,4"
                    Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <TextBlock x:Name="ItemListText" Foreground="#AAAAAA" FontSize="12"
                               TextWrapping="Wrap" LineHeight="19" Padding="6"/>
                </ScrollViewer>
            </Border>

            <!-- 按钮行：处置语义与弹窗问句直接呼应（用户在「仍要推送/跳过/取消」三案里拍板） -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
                <Button x:Name="BtnKeep" Content="仍要推送" FontSize="12" Height="30" Padding="14,0"
                        Background="#3A3A3A" Foreground="#E0E0E0"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand" Click="BtnKeep_Click"
                        ToolTip="已推送过的也照常包含进这次推送（比如打汇总版时想把它们再收进去）"/>
                <Button x:Name="BtnSkip" Content="跳过" FontSize="12" Height="30" Padding="14,0" Margin="8,0,0,0"
                        Background="#3A3A3A" Foreground="#E0E0E0"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand" Click="BtnSkip_Click"
                        ToolTip="已推送过的不再推送，只推没推送过的条目（旧版默认行为）"/>
                <Button x:Name="BtnCancel" Content="取消" FontSize="12" Height="30" Padding="14,0" Margin="8,0,0,0"
                        Background="#3A3A3A" Foreground="#E57373"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand" Click="BtnCancel_Click"
                        ToolTip="这批什么都不推"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
