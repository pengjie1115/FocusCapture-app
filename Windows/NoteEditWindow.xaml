<Window x:Class="FocusCapture.Windows.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑笔记" Width="560" Height="440"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NoteInfoText"
                   Foreground="#888888" FontSize="12"
                   Margin="0,0,0,8"
                   Text="笔记信息"/>

        <TextBox x:Name="EditBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Background="#252525"
                 Foreground="#E0E0E0"
                 BorderBrush="#555555"
                 BorderThickness="1"
                 Padding="8,6"
                 FontSize="13"
                 TextChanged="EditBox_TextChanged"
                 PreviewKeyDown="EditBox_PreviewKeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CharCountText"
                       Foreground="#666666" FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <!-- AI 整理（2026-09-26）：长文在这里编辑，也正是最需要"理一理"的场景 -->
            <Button x:Name="BtnAiTidy" Content="AI" FontSize="12" Height="28" Padding="14,0"
                    Margin="0,0,8,0"
                    Background="#3A3A3A" Foreground="#4CAF50"
                    BorderBrush="#4CAF50" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="AI 整理：把编辑框里这段理成有条理的内容（先出预览，再决定改不改）"
                    Click="BtnAiTidy_Click"/>
            <Button x:Name="BtnCancel" Content="取消" FontSize="12" Height="28" Padding="14,0"
                    Margin="0,0,8,0"
                    Background="#3A3A3A" Foreground="#CCCCCC"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存" FontSize="12" Height="28" Padding="18,0"
                    Background="#3A3A3A" Foreground="#4CAF50"
                    BorderBrush="#4CAF50" BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnSave_Click"/>
        </StackPanel>

        <!-- v3.5：待办编辑保存后时间识别建议条（覆盖层浮在编辑框上方，10 秒自动消失） -->
        <Canvas x:Name="SuggestLayer" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10">
            <Border x:Name="SuggestBar"
                    Canvas.Left="10" Canvas.Top="10"
                    Background="#2D2D2D"
                    BorderBrush="#FF9800"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,5"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SuggestText"
                               Foreground="#E0E0E0" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="SuggestDueSet" Content="设为提醒" FontSize="11" Height="22" Padding="10,0"
                            Background="#3A3A3A" Foreground="#4CAF50"
                            BorderBrush="#4CAF50" BorderThickness="1"
                            Cursor="Hand"
                            Click="SuggestDueSet_Click"/>
                    <Button x:Name="SuggestDueIgnore" Content="忽略" FontSize="11" Height="22" Padding="10,0"
                            Margin="6,0,0,0"
                            Background="#3A3A3A" Foreground="#888888"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            Click="SuggestDueIgnore_Click"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
