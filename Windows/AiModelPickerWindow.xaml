<Window x:Class="FocusCapture.Windows.AiModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="获取可用模型"
        Width="580" Height="620"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <!-- 禁用态必须自己上色：这套模板只有 hover 态，不给禁用态上色的话
                     「不能点」和「能点」长得一模一样（本项目在别的窗口上吃过这个亏）。
                     放在 hover 之后：WPF 后者优先，禁用时鼠标根本进不来、也不会误亮。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Foreground" Value="#6E6E6E"/>
                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button x:Name="BtnToggleAll" DockPanel.Dock="Right" Content="全选"
                    Width="80" Height="30" Margin="8,0,0,0" Click="BtnToggleAll_Click"/>
            <TextBox x:Name="SearchInput" Style="{StaticResource DarkTextBox}"
                     TextChanged="Search_TextChanged"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Margin="0,6,0,8"
                   Text="勾选要添加的模型。已在你的模型目录里的不会重复添加。"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ModelList" Margin="0,0,6,0"/>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="EmptyHint" Style="{StaticResource HintText}"
                   VerticalAlignment="Top" Margin="0,4,0,0" Visibility="Collapsed"
                   Text="没有匹配的模型（换个关键词试试；也可以回上一页手动添加模型 ID）。"/>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" Style="{StaticResource HintText}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消" Width="90" Height="32" Click="BtnCancel_Click"/>
                <Button x:Name="BtnAdd" Content="添加所选" Width="100" Height="32" Margin="10,0,0,0"
                        Click="BtnAdd_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
