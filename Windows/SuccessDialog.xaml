<Window x:Class="FocusCapture.Windows.SuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="320" Height="150"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <StackPanel Margin="20,18" VerticalAlignment="Center">
            <TextBlock Text="导出成功"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#4CAF50" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtFilePath"
                       Text="" FontSize="11"
                       Foreground="#777777"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="打开文件" Width="80" Height="28"
                        Background="#3A3A3A" Foreground="#CCCCCC"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" Click="OpenFile_Click"/>
                <Button Content="打开文件夹" Width="80" Height="28"
                        Background="#3A3A3A" Foreground="#CCCCCC"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" Click="OpenFolder_Click"/>
                <Button Content="关闭" Width="60" Height="28"
                        Background="#3A3A3A" Foreground="#AAAAAA"
                        BorderThickness="0" Cursor="Hand"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
