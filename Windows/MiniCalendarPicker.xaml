<UserControl x:Class="FocusCapture.Windows.MiniCalendarPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 2026-08-15 迷你日历选择器：Popup 承载紧凑月历（热力图 + 月份导航），
         点击日期格即回调并自动关闭。用于区间筛选的 📅 按钮（替代弹出整个 CalendarWindow 的笨重方案）。
         复用 CalendarWindow 的热力渲染逻辑（4 档热力色 + 今天描边 + 选中高亮）。 -->
    <Popup x:Name="PickerPopup"
           StaysOpen="False"
           AllowsTransparency="True"
           Placement="Bottom">
        <Border CornerRadius="8" Background="#1E1E1E"
                BorderBrush="#3A3A3A" BorderThickness="1"
                Margin="0,4,0,0"
                Padding="10,8">
            <Grid Width="252">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 月份导航 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Button x:Name="BtnPrev"
                            Content="‹" FontSize="18"
                            Width="28" Height="24"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnPrev_Click"/>
                    <TextBlock x:Name="MonthTitle"
                               Text=""
                               Foreground="#E0E0E0"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnNext"
                            Content="›" FontSize="18"
                            Width="28" Height="24"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Margin="0,0,52,0"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnNext_Click"/>
                    <Button x:Name="BtnToday"
                            Content="今天" FontSize="11"
                            Height="24" Padding="8,0"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#4CAF50"
                            BorderBrush="#4CAF50" BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnToday_Click"/>
                </Grid>

                <!-- 星期表头 -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                    <TextBlock Text="日" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="一" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="二" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="三" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="四" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="五" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="六" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                </UniformGrid>

                <!-- 日期格（热力色） -->
                <UniformGrid x:Name="DayGrid" Grid.Row="2" Columns="7"/>
            </Grid>
        </Border>
    </Popup>
</UserControl>
