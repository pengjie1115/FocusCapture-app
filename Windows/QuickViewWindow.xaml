<Window x:Class="FocusCapture.Windows.QuickViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCapture.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        Width="620" Height="480"
        Background="#1E1E1E"
        Opacity="0.80"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- v3.9：无框窗口挂 WindowChrome —— 边缘自由缩放 + 最大化时尊重任务栏工作区
         （WPF 已知坑：WindowStyle=None 直接 Maximized 会盖住任务栏）。CaptionHeight=0 保留自绘标题栏拖拽。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- v3.5：筛选 ToggleButton（选中=绿边绿字） -->
        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v3.5：深色 ComboBox（下拉项高亮绿色） -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="6,3" VerticalAlignment="Center"/>
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,22,4"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" TargetName="toggle"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 笔记条目右键菜单（v3.5 新增：设置提醒/取消提醒，仅待办可用） -->
        <ContextMenu x:Key="NoteContextMenu"
                     Background="#2D2D2D"
                     Foreground="#E0E0E0"
                     Opened="NoteContextMenu_Opened">
            <MenuItem Header="AI 翻译" Click="CtxAiTranslate_Click"/>
            <MenuItem Header="AI 搜索" Click="CtxAiSearch_Click"/>
            <Separator/>
            <MenuItem Header="复制" Click="CtxCopy_Click"/>
            <MenuItem Header="编辑" Click="CtxEdit_Click"/>
            <MenuItem Header="删除" Click="CtxDelete_Click"/>
            <Separator/>
            <MenuItem x:Name="CtxSetDue" Header="设置提醒…" Click="CtxSetDue_Click"/>
            <MenuItem x:Name="CtxClearDue" Header="取消提醒" Click="CtxClearDue_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- RootBorder：最大化时圆角由代码置 0（否则四角露透明缺口），还原后恢复 8 -->
    <Border x:Name="RootBorder" CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题栏 + 选择工具栏 + 筛选行（v3.5） -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行（v3.9 可组装）：左/右两组按钮由设置驱动生成（RebuildToolbar），
                         最右「窗口铬区」固定 = 分隔线 + 最小化/最大化/关闭，不占自定义槽位 -->
                    <Grid Grid.Row="0" Margin="14,0" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseDown">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="灵感速览"
                                       Foreground="#CCCCCC"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel x:Name="ToolbarLeftHost"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel x:Name="ToolbarRightHost"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Border Width="1" Height="16" Background="#3A3A3A"
                                    Margin="4,0,6,0" VerticalAlignment="Center"/>
                            <!-- 铬区按钮（2026-09-13）：字符改为 Segoe MDL2 Assets 矢量图标，
                                 并显式清零 Padding —— 全局 Button 样式带 Padding="8,4"，
                                 而这三个按钮只有 24~28px 宽，不清零会挤压出偏移/裁切。
                                 此前用的 ─ □ × 属于普通文本字符，基线偏位导致视觉不居中。 -->
                            <Button x:Name="BtnMinimize"
                                    Content="&#xE921;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="最小化（任务栏点击可恢复）"
                                    Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize"
                                    Content="&#xE922;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Width="24" Height="24"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="最大化 / 还原"
                                    Click="BtnMaximize_Click"/>
                            <Button x:Name="BtnClose"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Width="28" Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 选择工具栏：左=选择控件 / 中=模式指示+返回 / 右=预留 -->
                    <Border Grid.Row="1" Background="#1F1F1F"
                            x:Name="SelectionBar"
                            Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：选择控件（全选/反选/已选/删除已选） -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedCountText"
                                           Text=""
                                           Foreground="#4CAF50"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Visibility="Collapsed"/>
                                <Button x:Name="BtnSelectAll"
                                        Content="全选"
                                        FontSize="11" Width="48" Height="24"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        Foreground="#888888"
                                        BorderBrush="#555555" BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnSelectAll_Click"/>
                                <Button x:Name="BtnInvert"
                                        Content="反选"
                                        FontSize="11" Width="48" Height="24"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        Foreground="#888888"
                                        BorderBrush="#555555" BorderThickness="1"
                                        Cursor="Hand"
                                        Click="BtnInvert_Click"/>
                                <Button x:Name="BtnDeleteSelected"
                                        Content="删除已选"
                                        FontSize="11" Width="80" Height="24"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        Foreground="#E57373"
                                        BorderBrush="#E57373" BorderThickness="1"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="BtnDeleteSelected_Click"/>
                            </StackPanel>

                            <!-- 中：模式指示 + 返回按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeIndicator"
                                           Foreground="#888888" FontSize="11"
                                           VerticalAlignment="Center"
                                           Text=""/>
                                <Button x:Name="BtnReturnToDate"
                                        Content="↩ 返回"
                                        FontSize="11" Width="60" Height="22"
                                        Margin="12,0,0,0"
                                        Background="Transparent"
                                        Foreground="#4CAF50"
                                        BorderBrush="#4CAF50" BorderThickness="1"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="BtnReturnToDate_Click"/>
                            </StackPanel>

                            <!-- 右：同步状态文字 -->
                            <TextBlock x:Name="SyncStatusText"
                                       Grid.Column="2"
                                       Text=""
                                       Foreground="#888888"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 筛选行（v3.5）：类型 4 档多选 + 来源下拉 -->
                    <Border Grid.Row="2" Background="#1F1F1F" Padding="14,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="筛选："
                                       Foreground="#666666" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ToggleButton x:Name="FilterAll" Content="全部" Tag="All" IsChecked="True"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Click="TypeFilter_Click"/>
                            <ToggleButton x:Name="FilterNote" Content="笔记" Tag="Note"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Click="TypeFilter_Click"/>
                            <ToggleButton x:Name="FilterTodo" Content="待办" Tag="Todo"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Click="TypeFilter_Click"/>
                            <ToggleButton x:Name="FilterDone" Content="已办" Tag="Done"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Click="TypeFilter_Click"/>
                            <ToggleButton x:Name="FilterFuture" Content="未到期" Tag="Future"
                                          Style="{StaticResource FilterToggleStyle}"
                                          Click="TypeFilter_Click"/>
                            <TextBlock Text="来源"
                                       Foreground="#666666" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <!-- 来源多选下拉（v3.6）：Button 触发 Popup，垂直列表多选；框内未选=空白、已选=「已选 N 个来源」 -->
                            <Button x:Name="SourceFilterBtn" Width="110" Height="24" Cursor="Hand"
                                    Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                    Click="SourceFilterBtn_Click"
                                    ToolTip="按来源筛选（可多选，再点取消）">
                                <TextBlock x:Name="SourceFilterText" Text=""
                                           Foreground="#888888" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <Popup x:Name="SourceFilterPopup"
                                   PlacementTarget="{Binding ElementName=SourceFilterBtn}"
                                   Placement="Bottom" StaysOpen="True"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   VerticalOffset="2">
                                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                        CornerRadius="4" MinWidth="170" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="SourceFilterList" Margin="3"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NotesList" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" CornerRadius="6"
                                        Margin="0,0,0,3" Padding="6,6,6,6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NoteItem_Click"
                                        ContextMenu="{StaticResource NoteContextMenu}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="NoteCheckBox_Click"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,10,0"
                                                  Cursor="Hand"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <!-- 时间行 + 待办徽标 + 已读小标（v3.5） -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Foreground="#888888" FontSize="11"
                                                           Text="{Binding DisplayTime}"
                                                           VerticalAlignment="Center"/>
                                                <!-- 待办徽标：绿色小标签，可点击切换待办/已办（v3：已办=灰底「已办」字，可再点恢复）；点击需吞事件防冒泡复制 -->
                                                <Border x:Name="TodoBadge" Tag="{Binding}"
                                                        CornerRadius="3" Padding="4,1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        ToolTip="点击切换待办/已办"
                                                        MouseLeftButtonDown="TodoBadge_Click">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Background" Value="#4CAF50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTodo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Background" Value="#777777"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="待办" FontSize="9" Foreground="White" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="已办" FontSize="9" Foreground="#CCCCCC" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <!-- 已读小标：橙字「已读」 -->
                                                <TextBlock Text="已读" FontSize="9" Foreground="#FF9800"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- 等高设计：内容区固定 40px，单行截断预览（NoWrap），双击编辑不撑高列表；
                                                 重复笔记（Content 完全相同 ≥2 次）字体红色；已办（v3.5）灰字+删除线 -->
                                            <TextBlock FontSize="13"
                                                       Text="{Binding DisplayPreview}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Height="40"
                                                       VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="#777777"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Foreground="#555555" FontSize="11"
                                                       Text="{Binding SourceWindow}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding SourceWindow, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <!-- 编辑态：内容区 TextBox 固定 34px（与非编辑态等高，列表零跳动） -->
                                        <Grid Grid.Column="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Foreground="#888888" FontSize="11"
                                                       Text="{Binding DisplayTime}"/>
                                            <Grid Grid.Row="1">
                                                <TextBox x:Name="EditBox"
                                                         Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Height="40"
                                                         BorderThickness="0"
                                                         VerticalScrollBarVisibility="Hidden"
                                                         Background="#2D2D2D"
                                                         Foreground="#E0E0E0"
                                                         Padding="6,2"
                                                         Cursor="IBeam"/>
                                                <Button Content="⛶" FontSize="12" Width="22" Height="22" Padding="0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,1,1,0"
                                                        Background="Transparent" Foreground="#777777"
                                                        BorderThickness="0"
                                                        Opacity="0.55"
                                                        ToolTip="全屏编辑"
                                                        Cursor="Hand"
                                                        Panel.ZIndex="1"
                                                        Click="BtnFullEdit_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>
                                            <TextBlock Grid.Row="2" Foreground="#555555" FontSize="11"
                                                       Text="{Binding SourceWindow}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding SourceWindow, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </Grid>
                                        <!-- 右侧按钮区：AI 徽章 + 删除 + 保存/取消（仅编辑态） -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="6,0,0,0">
                                            <Border Background="#4CAF50" CornerRadius="3" Padding="4,1" Margin="0,0,0,2"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAiFills}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="AI" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- AI 整理 + × 删除 并排：AI 在删除左边（2026-09-26 用户要求「与 × 同行、放在它前面」）。
                                                 刻意用「深底 + 绿框绿字」小按钮，与上面那个「绿底白字 AI 徽章」（表示这条已有 AI 释义）
                                                 在形状与配色上都错开，避免看混。 -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button x:Name="BtnAiTidy" Content="AI"
                                                        FontSize="10" FontWeight="SemiBold"
                                                        Width="22" Height="22" Padding="0"
                                                        Margin="0,0,4,0"
                                                        Background="#3A3A3A" Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        ToolTip="AI 整理：把这一大段理成有条理的内容（先出预览，再决定改不改）"
                                                        Click="BtnAiTidy_Click"/>
                                                <Button Content="×" FontSize="14" Width="22" Height="22" Padding="0"
                                                        Margin="0,0,0,0"
                                                        Background="Transparent"
                                                        Foreground="#666666"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="BtnDeleteOne_Click"
                                                        Tag="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="保存" FontSize="11" Height="24" Padding="10,0"
                                                        Margin="0,0,0,4"
                                                        Background="#3A3A3A" Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnEditSave_Click"/>
                                                <Button Content="取消" FontSize="11" Height="24" Padding="10,0"
                                                        Background="#3A3A3A" Foreground="#CCCCCC"
                                                        BorderBrush="#555555" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnEditCancel_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Text="这一天还没有笔记"
                           Foreground="#666666"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <!-- 浮动工具条覆盖层：Canvas 不参与内容布局；无 Background 天然不拦截鼠标（列表区域穿透正常） -->
                <Canvas x:Name="FloatToolbarCanvas"
                        Panel.ZIndex="99">
                    <Border x:Name="FloatToolbar"
                            Canvas.Left="10" Canvas.Top="10"
                            Background="#2D2D2D"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            Visibility="Collapsed"
                            IsHitTestVisible="True"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="翻译" FontSize="11" Height="22" Padding="8,0"
                                    Margin="0,0,4,0"
                                    Background="#3A3A3A" Foreground="#E0E0E0"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Tag="Translate"
                                    Click="FloatToolbar_Click"/>
                            <Button Content="搜索" FontSize="11" Height="22" Padding="8,0"
                                    Margin="0,0,4,0"
                                    Background="#3A3A3A" Foreground="#E0E0E0"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Tag="Search"
                                    Click="FloatToolbar_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- v3.5 时间识别建议条：编辑保存后识别到未来时间 → 浮出（编辑区上方，10 秒自动消失） -->
                    <Border x:Name="SuggestBar"
                            Canvas.Left="10" Canvas.Top="10"
                            Background="#2D2D2D"
                            BorderBrush="#FF9800"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,5"
                            Visibility="Collapsed"
                            IsHitTestVisible="True"
                            Panel.ZIndex="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SuggestText"
                                       Foreground="#E0E0E0" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="SuggestDueSet" Content="设为提醒" FontSize="11" Height="22" Padding="10,0"
                                    Background="#3A3A3A" Foreground="#4CAF50"
                                    BorderBrush="#4CAF50" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="SuggestDueSet_Click"/>
                            <Button x:Name="SuggestDueIgnore" Content="忽略" FontSize="11" Height="22" Padding="10,0"
                                    Margin="6,0,0,0"
                                    Background="#3A3A3A" Foreground="#888888"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="SuggestDueIgnore_Click"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>