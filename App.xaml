<Application x:Class="FocusCapture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 2026-08-15：全局深色 Theme 兜底，避免 TextBox/Button 在某些状态下被 Aero 主题覆盖。
                 局部窗口如有特殊需求可在自己 Window.Resources 覆盖。 -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="CaretBrush" Value="#4CAF50"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="CaretBrush" Value="#4CAF50"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2026-09-21：全局深色滚动条（配色方案 A+B：常态滑块 #3E3E3A 隐入背景，悬停/拖动浮出品牌绿 #5FA46A）。
                 重模板去掉默认的白轨道与上下箭头按钮，轨道透明融入面板；
                 所有窗口与弹出层（含 ContextMenu、ComboBox 下拉）统一生效。
                 局部窗口如有特殊需求可在自己 Window.Resources 覆盖。 -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" IsEnabled="False" Focusable="False"
                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" IsEnabled="False" Focusable="False"
                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" Background="#3E3E3A" CornerRadius="3"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="#5FA46A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="#5FA46A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="PART_Track" Property="Margin" Value="2,0"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Height" Value="10"/>
                                    <Setter Property="MinHeight" Value="10"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="MinHeight" Value="10"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 2026-09-21：全局深色 ContextMenu 模板。
                 默认 Aero2 模板在菜单左侧硬编码 28px 浅色图标槽（一块浅灰圆角矩形 + 浅灰/纯白两条高光线），
                 深色背景下就是一条刺眼白条（悬浮球右键菜单实测；它不是滚动条，滚动条样式治不了）。
                 整体换干净模板（深色圆角边框 + ScrollViewer，无图标槽），全 App 右键菜单统一生效。
                 注意：本段注释刻意不写出那三个色值 —— 慢层检查点全文禁这些色值，写出来就自己把自己打红。 -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#2B2B28"/>
                <Setter Property="BorderBrush" Value="#3A3A37"/>
                <Setter Property="Foreground" Value="#E6E6E2"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2026-09-24：全局深色 MenuItem 模板。
                 背景：Aero2 默认模板里「子菜单弹出层」的 Border 背景写死浅色主题资源（非 TemplateBinding），
                 覆盖 Background/Foreground 治不了它 —— AI 问答会话菜单实测：顶层菜单是深色的（ContextMenu 模板生效），
                 点开「分组到… / 导出」的子菜单却是白底，菜单项文字又是深色主题的浅色 → 白底白字看不清。
                 本项目所有菜单都是 ContextMenu（无 Menu 顶栏控件，2026-09-24 全库扫描确认），
                 所以模板只处理 SubmenuItem / SubmenuHeader 两种角色，未处理 TopLevelItem / TopLevelHeader ——
                 若未来引入 Menu 顶栏控件，此模板会把它渲染错乱，届时必须补全角色。 -->
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#E6E6E2"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <!-- Grid 是唯一模板根：Border（本项）与 Popup（子菜单）都要挂在它下面，
                                 ControlTemplate 不允许两个并列子级（MC3089 实测） -->
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 勾选标记（分组到…里标当前归属用）-->
                                        <Path x:Name="Check" Grid.Column="0"
                                              Data="M0,4 L3.2,7.2 L9,1"
                                              Stroke="#7A9E7A" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Margin="0,0,6,0" VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                        <!-- 子菜单箭头（有下一级才显示）-->
                                        <Path x:Name="Arrow" Grid.Column="2"
                                              Data="M0,0 L4,4 L0,8"
                                              Fill="#9A9A96"
                                              Margin="10,0,2,0" VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <!-- 子菜单弹出层：背景/边框与 ContextMenu 同一套深色，Margin 给投影留空隙 -->
                                <Popup x:Name="PART_Popup"
                                       Placement="Right"
                                       VerticalOffset="-6"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       AllowsTransparency="True">
                                    <Border Background="#2B2B28"
                                            BorderBrush="#3A3A37"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            Margin="0,0,8,8">
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- TargetName 只在模板触发器里合法，所以这两条放这里而不是 Style.Triggers -->
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="#3A3A37"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#6A6A66"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
